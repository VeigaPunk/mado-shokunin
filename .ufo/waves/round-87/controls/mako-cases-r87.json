      },
      "config": ".config/mako/config",
      "args": {
        "app-name": "alpha",
        "urgency": "normal",
        "mode": []
      },
      "expect": {
        "effective": {
          "anchor": "bottom-left",
          "output": "HDMI-1"
        },
        "refusals": "none"
      },
      "pin": "mako.5 line 523: for all style options, overwritten with any configured in the global section."

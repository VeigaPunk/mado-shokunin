xkb_keymap {
xkb_keycodes { minimum = 8; maximum = 255; <A> = 10; };
xkb_types {
    virtual_modifiers Foo = none;
    type "T" {
        modifiers = Shift+Foo;
        map[Shift] = 2;
        map[Foo] = 3;
    };
};
xkb_compatibility { };
xkb_symbols {
    key <A> { type = "T", [ a, A, b ] };
};
};

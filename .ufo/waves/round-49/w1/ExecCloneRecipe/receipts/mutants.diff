+def _r49_probe():
+    import errno as _errno
+    import tempfile as _tf
+    _r = []
+
+    def _en(ex):
+        return _errno.errorcode.get(getattr(ex, "errno", None), repr(getattr(ex, "errno", None)))
+    _rd, _wr = os.pipe()

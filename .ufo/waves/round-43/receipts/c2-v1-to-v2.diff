> def strip_comments(text, path):
>     ext = os.path.splitext(path)[1].lower()
>     if ext in (".cpp", ".hpp", ".h", ".cc"):
>         text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
>         return re.sub(r"//[^\n]*", " ", text)
>     if ext in (".py", ".conf"):
>         return re.sub(r"#[^\n]*", " ", text)
>     return text
> 

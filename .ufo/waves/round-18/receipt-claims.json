{
  "schema": "mado-receipt-claims-v1",
  "lane": "/home/vgpnk/Projects/shokunin/mado-shokunin",
  "rev_semantics": {
    "WORKTREE": "read the receipt file directly (authored fixtures); bind_rev is then required and is the revision the tool identity binds to",
    "PENDING-L1": "placeholder for a receipt that is not committed yet; evaluates as PENDING (could-not-evaluate, exit 2, never credit)"
  },
  "bind_rev_semantics": "Revision whose <tool> bytes the receipt attests; defaults to rev. A declared value other than rev must equal the receipt's own measured_commit and marks a before-state receipt (it deliberately ran the older tool). Leaving it unset on a receipt whose measured_commit tool differs from rev is STALE.",
  "expect_semantics": {
    "ok": "provenance complete, measured_commit an ancestor of the read revision, tool bytes equal at measured_commit and after it",
    "MISSING_PROVENANCE": "no tool_sha256 and/or measured_commit in the receipt",
    "SHA_MISMATCH": "tool_sha256 is not the digest of the tool at measured_commit",
    "STALE": "internally consistent receipt that attests a superseded tool at the claimed revision (R17-V1/V2)",
    "NOT_ANCESTOR": "measured_commit is not an ancestor of the revision the claim reads at",
    "PRODUCER_MISMATCH": "the receipt's own tool= token names a producer the claim does not"
  },

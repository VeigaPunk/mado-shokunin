+def shell_functions(pairs):
+    """Definitions visible in one command text: {name: (start, body_text)}.
+
+    Only `name() { ... }` and `function name { ... }` are read, only when the
+    closing `}` is present in the same text, and a name defined twice is
+    dropped: neither its body nor its call site is then interpreted.
+    """
+    funcs, dup = {}, set()
+    i = 0
+    while i < len(pairs):
+        line = pairs[i][0]
+        try:
+            toks = tokenize(line) if line.strip() else []
+        except ValueError:
+            i += 1
+            continue
+        name, rest, keyword = None, [], False
+        if toks and toks[0] == "function" and len(toks) > 1 and SHELL_IDENT.match(toks[1]):
+            name, rest, keyword = toks[1], toks[2:], True
+        elif len(toks) > 1 and SHELL_IDENT.match(toks[0]) and toks[1] in ("()", "("):
+            name, rest = toks[0], toks[1:]
+        if name is not None:
+            if rest[:1] == ["()"]:
+                rest = rest[1:]
+            elif rest[:2] == ["(", ")"]:
+                rest = rest[2:]
+            elif not keyword:
+                name = None
+        if name is None or not rest or rest[0] != "{":
+            i += 1
+            continue
+        start = i
+        if len(rest) > 1 and rest[-1] == "}":
+            body = " ".join(rest[1:-1])
+            i += 1
+        else:
+            parts = [" ".join(rest[1:])] if len(rest) > 1 else []
+            j, closed = i + 1, False
+            while j < len(pairs):
+                ln = pairs[j][0]
+                try:
+                    t2 = tokenize(ln) if ln.strip() else []
+                except ValueError:
+                    t2 = ln.split()
+                if t2 and t2[-1] == "}":
+                    if t2[:-1]:
+                        parts.append(" ".join(t2[:-1]))
+                    closed = True
+                    break
+                parts.append(ln)
+                j += 1
+            if not closed:
+                i += 1
+                continue
+            body = "\n".join(parts)
+            i = j + 1
+        if name in funcs:
+            dup.add(name)
+        funcs[name] = (start, body)
+    for name in dup:
+        funcs.pop(name, None)
+    return funcs
+

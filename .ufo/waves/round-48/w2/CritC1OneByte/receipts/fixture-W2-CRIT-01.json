{
 "id": "W2-CRIT-01-cached-cmd-newline",
 "class": "WARM-DIFFERS",
 "env": {
  "XDG_CONFIG_HOME": "$ROOT/home/.config",
  "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
  "XDG_DATA_HOME": "$ROOT/home/.local/share",
  "XDG_DATA_DIRS": "$ROOT/usr/share",
  "XDG_CURRENT_DESKTOP": "Hyprland"
 },
 "files": {
  "home/.config/hyprland-xdg-terminals.list": "foot.desktop\n",
  "usr/share/applications/foot.desktop": "[Desktop Entry]\nType=Application\nCategories=TerminalEmulator;\nExec=foot\n"
 },
 "exec": [
  "bin/foot"
 ],
 "args": [
  "--print-cmd"
 ],
 "mtime": 1600000000,
 "prime": {
  "args": [
   "--print-cmd"
  ]
 },
 "after": {
  "cache_lines": {
   "11": "f\not\u001eEND_OF_EXEC_USEP"
  },
  "mtime": 1600000000
 },
 "expect": {
  "rc": 0,
  "stdout": "f\not\n"
 },
 "cold": {
  "rc": 0,
  "stdout": "foot\n"
 },
 "state": "hit"
}
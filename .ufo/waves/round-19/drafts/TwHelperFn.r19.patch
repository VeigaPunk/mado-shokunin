+def resolve(node, env, hops=0):
+    """Follow a parameter bound to a literal argument at the same-text call."""
+    while isinstance(node, ast.Name) and hops < 8:
+        nxt = env.get(node.id)
+        if nxt is None:
+            break
+        node, hops = nxt, hops + 1
+    return node
+

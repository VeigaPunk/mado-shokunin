+def last_unquoted(text, target):
+    """Index of the last occurrence of target outside quotes, or -1."""
+    quote, i, last = None, 0, -1
+    while i < len(text):
+        ch = text[i]
+        if quote:
+            if ch == "\\" and quote == '"':
+                i += 2
+                continue
+            if ch == quote:
+                quote = None
+        elif ch == "\\":
+            i += 2
+            continue
+        elif ch in ("'", '"'):
+            quote = ch
+        elif ch == target:
+            last = i
+        i += 1
+    return last

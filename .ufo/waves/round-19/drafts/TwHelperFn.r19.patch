+def literal_node(node):
+    """True when an argument is literal text the transcript states outright."""
+    if isinstance(node, ast.Constant) and (node.value is None or
+                                           isinstance(node.value, (str, int, float, bool))):
+        return True
+    if isinstance(node, (ast.List, ast.Tuple)) and all(literal_node(e) for e in node.elts):
+        return True
+    return False
+

  "subject": "tools/mado-action-plan.py invoked as: python3 tools/mado-action-plan.py --plan <plan>.json --policy .ufo/waves/round-16/safety-policy.json",
  "assumptions": {
    "policy": "All cases are evaluated against the round-16 committed paused policy (.ufo/waves/round-16/safety-policy.json with paused=true) unless a case embeds its own policy field.",
    "exit_codes": {
      "0": "plan evaluated clean, finding plan_safe",
      "1": "plan evaluated and refused with a stable named reason",
      "2": "gate could not evaluate: malformed plan or policy (fail closed)"
    },
    "plan_schema": "plan is a JSON object with an actions list; each action is an object with a string kind and a list-of-strings argv. The gate classifies statically; argv is data and is never executed.",
    "finding_priority": "One finding per verdict. For multi-action plans the first refusing action in declared order wins; plan/policy malformation is detected before any action classification, so a malformed policy yields policy_malformed even when the plan is clean.",
    "policy_field": "A case MAY carry an embedded policy object; when present the embedded object REPLACES the policy file input wholesale for that case (replacement, not overlay or merge — hidden defaults are never filled in). Malformed-policy pins therefore embed a FULL copy of the canonical safety-policy.json fields and mutate exactly the named key, so each pin isolates one defect rather than failing on incidental missing fields.",
    "scope_limit": "L1 scope decision: the gate is ONLY a declared-kind plus finite 12-basename screen (pacman, yay, paru, systemctl, hyprctl, omarchy, libinput, evtest, sudo, sh, bash, env). Unlisted argv[0] is NOT screened: helper installers (omarchy-pkg-add), interpreters (python3 -c), and arbitrary wrappers pass as plan_safe. This is by design — no broad allowlist, prefix, or shell enforcement; argv is never executed and the gate asserts no privacy, probe-safety, or host-prevention property. Cases labelled residual_control pin that boundary deliberately.",
    "finding_vocabulary": {
      "plan_safe": "exit 0; every action admitted",
      "blocked_action_kind:<kind>": "exit 1; action kind is policy-blocked (package-install, service-mutate, compositor-mutate, input-capture)",
      "denied_executable:<basename>": "exit 1; allowed kind (read-source, repo-write) carries argv[0] whose basename is on the refused-executable list (pacman, yay, paru, systemctl, hyprctl, omarchy, libinput, evtest, sudo, sh, bash, env)",
      "unknown_action_kind": "exit 1; action kind not in the policy vocabulary (fail closed)",
      "empty_argv": "exit 1; allowed kind carries an empty argv list, violating the nonempty-argv requirement",
      "plan_malformed": "exit 2; plan JSON violates the schema (missing/non-object actions, missing kind, missing/non-list argv, non-string argv element)",
      "policy_malformed": "exit 2; policy JSON unreadable or violates the policy schema, including a paused field that is missing, non-boolean, not true, or a policy carrying unexpected keys",
      "snapshot_tampered": "exit 2; --frozen input digests do not match expected.json"
    },
    "independence": "Cases are authored from the dispatch spec and L1 scope decisions, not from SafetyGate's implementation output. The finding vocabulary was reconciled and adopted verbatim by the landed gate, so BOTH expected_code AND expected_finding are authoritative expectations — any mismatch is an implementation bug to adjudicate, not a naming drift to retrofit."
  },

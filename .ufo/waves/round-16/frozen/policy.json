{
  "schema": "mado-action-plan-policy-v1",
  "paused": true,
  "paused_scope": [
    "package-install",
    "service-mutate",
    "compositor-mutate",
    "input-capture"
  ],
  "deny_executables": [
    "pacman",
    "yay",
    "paru",
    "systemctl",
    "hyprctl",
    "omarchy",
    "libinput",
    "evtest",
    "sudo",
    "sh",
    "bash",
    "env"
  ],
  "kinds": {
    "read-source": {
      "disposition": "allow",
      "argv_nonempty": true
    },
    "repo-write": {
      "disposition": "allow",
      "argv_nonempty": true
    },
    "package-install": {
      "disposition": "deny"
    },
    "service-mutate": {
      "disposition": "deny"
    },
    "compositor-mutate": {
      "disposition": "deny"
    },
    "input-capture": {
      "disposition": "deny"
    }
  }
}

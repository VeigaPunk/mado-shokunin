{
  "id": "k-split-ifs-trailing",
  "class": "proposed-kill",
  "env": {
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_DATA_HOME": "$ROOT/home/.local/share",
    "XDG_DATA_DIRS": "$ROOT/usr/share",
    "XDG_CURRENT_DESKTOP": "Hyprland:"
  },
  "files": {
    "usr/share/applications/foot.desktop": "[Desktop Entry]\nType=Application\nName=foot\nExec=foot\nCategories=System;TerminalEmulator;\n",
    "usr/share/applications/kitty.desktop": "[Desktop Entry]\nType=Application\nName=kitty\nExec=kitty\nCategories=System;TerminalEmulator;\n",
    "home/.config/-xdg-terminals.list": "kitty.desktop\n"
  },
  "exec": ["bin/foot", "bin/kitty"],
  "args": ["--print-id"]
}

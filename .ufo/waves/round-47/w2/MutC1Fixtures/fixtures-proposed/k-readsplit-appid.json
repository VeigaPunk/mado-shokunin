{
  "id": "k-readsplit-appid",
  "class": "proposed-kill",
  "env": {
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_DATA_HOME": "$ROOT/home/.local/share",
    "XDG_DATA_DIRS": "$ROOT/usr/share",
    "XDG_CURRENT_DESKTOP": "Hyprland"
  },
  "files": {
    "usr/share/applications/foot.desktop": "[Desktop Entry]\nType=Application\nName=foot\nExec=foot\nX-TerminalArgAppId=--class=\nCategories=System;TerminalEmulator;\n"
  },
  "exec": ["bin/foot"],
  "args": ["--print-cmd", "--app-id=x="]
}

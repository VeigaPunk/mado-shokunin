{
  "id": "k-action-id-underscore",
  "class": "proposed-kill",
  "env": {
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_DATA_HOME": "$ROOT/home/.local/share",
    "XDG_DATA_DIRS": "$ROOT/usr/share",
    "XDG_CURRENT_DESKTOP": "Hyprland"
  },
  "files": {
    "usr/share/applications/foot.desktop": "[Desktop Entry]\nType=Application\nName=foot\nExec=foot\nActions=a_b;\n[Desktop Action a_b]\nExec=footclient\nCategories=System;TerminalEmulator;\n",
    "home/.config/xdg-terminals.list": "foot.desktop:a_b\n"
  },
  "exec": ["bin/foot", "bin/footclient"],
  "args": ["--print-id"]
}

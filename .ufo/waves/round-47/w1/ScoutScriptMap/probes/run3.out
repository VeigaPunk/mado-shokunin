--- unk: rc=0 cache=['xdg-terminal-exec']
 stdout='t.desktop\nfoo\n-e\nx\n'
 stderr=''
--- noargs_cmd: rc=0 cache=['xdg-terminal-exec']
 stdout='foo\n'
 stderr=''
--- multinl: rc=0 cache=['xdg-terminal-exec']
 stdout='t.desktop\nfoo\n-e\nx\n'
 stderr=''
--- dup: rc=0 cache=[]

{
  "args": [
    "--print-id",
    "--print-path",
    "--print-cmd"
  ],
  "class": "list/action",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "Alacritty.desktop\n$ROOT/home/.local/share/applications/Alacritty.desktop\nalacritty\n"
  },
  "files": {
    "home/.config/xdg-terminals.list": "Alacritty.desktop:New action\n",
    "home/.local/share/applications/Alacritty.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\nActions=New;\n[Desktop Action New]\nExec=alacritty --new\n"
  },
  "id": "P10c-action-space"
}

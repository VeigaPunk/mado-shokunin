{
  "args": [
    "--print-id",
    "--print-path",
    "--print-cmd"
  ],
  "class": "find/symlink-dir",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "Alacritty.desktop\n$ROOT/home/.local/share/applications/Alacritty.desktop\nfoot\n"
  },
  "files": {
    "usr/share/applications/Alacritty.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\nTerminalArgExec=-e\n"
  },
  "id": "P09-symlink-into-dir",
  "setup": {
    "symlinks": {
      "home/.local/share": "../../usr/share"
    }
  }
}

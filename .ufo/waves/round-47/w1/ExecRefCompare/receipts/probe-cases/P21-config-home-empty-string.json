{
  "args": [
    "--print-id"
  ],
  "class": "env/empty-string",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "Foot.desktop\n"
  },
  "files": {
    "home/.config/xdg-terminals.list": "Foot.desktop\n",
    "home/.local/share/applications/Alacritty.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\nTerminalArgExec=-e\n",
    "usr/share/applications/Foot.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\nTerminalArgExec=-e\n"
  },
  "id": "P21-config-home-empty-string"
}

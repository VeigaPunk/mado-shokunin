{
  "args": [
    "--print-id",
    "--print-path",
    "--print-cmd"
  ],
  "class": "find/unreadable",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "Alacritty.desktop\n$ROOT/home/.local/share/applications/Alacritty.desktop\nalacritty\n"
  },
  "files": {
    "home/.local/share/applications/Alacritty.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\nTerminalArgExec=-e\n",
    "usr/share/applications/Zed.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\n"
  },
  "id": "P09b-unreadable-second",
  "setup": {
    "modes": {
      "usr/share/applications/Zed.desktop": 0
    }
  }
}

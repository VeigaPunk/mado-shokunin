{
  "args": [
    "--print-cmd",
    "--",
    "cmd"
  ],
  "class": "args/compat-default",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "alacritty\n--x\ncmd\n"
  },
  "files": {
    "home/.config/xdg-terminals.list": "/execarg_default:Alacritty.desktop:--x\nAlacritty.desktop\n",
    "home/.local/share/applications/Alacritty.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\n"
  },
  "id": "P07j-execarg-default"
}

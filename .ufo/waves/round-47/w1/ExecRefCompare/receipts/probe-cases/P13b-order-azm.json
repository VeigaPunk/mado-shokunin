{
  "args": [
    "--print-id",
    "--print-path",
    "--print-cmd"
  ],
  "class": "order/readdir",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "Mmm.desktop\n$ROOT/usr/share/applications/Mmm.desktop\nalacritty\n"
  },
  "files": {
    "usr/share/applications/Aaa.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\n",
    "usr/share/applications/Mmm.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\n",
    "usr/share/applications/Zzz.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=alacritty\n"
  },
  "id": "P13b-order-azm"
}

{
  "args": [
    "--print-id",
    "--print-path",
    "--print-cmd"
  ],
  "class": "entry/showin-case",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/local/share:$ROOT/usr/share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 1,
    "stdout": ""
  },
  "files": {
    "usr/share/applications/Foot.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\nOnlyShowIn=hyprland;\n"
  },
  "id": "P10f-showin-case"
}

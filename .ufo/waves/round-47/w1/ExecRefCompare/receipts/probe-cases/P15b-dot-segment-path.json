{
  "args": [
    "--print-path"
  ],
  "class": "find/path-rewrite",
  "env": {
    "XDG_CONFIG_DIRS": "$ROOT/etc/xdg",
    "XDG_CONFIG_HOME": "$ROOT/home/.config",
    "XDG_CURRENT_DESKTOP": "Hyprland",
    "XDG_DATA_DIRS": "$ROOT/usr/./share",
    "XDG_DATA_HOME": "$ROOT/home/.local/share"
  },
  "exec": [
    "bin/alacritty",
    "bin/foot"
  ],
  "expect": {
    "rc": 0,
    "stdout": "$ROOT/usr/Foot.desktop\n"
  },
  "files": {
    "usr/share/applications/Foot.desktop": "[Desktop Entry]\nCategories=TerminalEmulator;\nExec=foot\nTerminalArgExec=-e\n"
  },
  "id": "P15b-dot-segment-path"
}

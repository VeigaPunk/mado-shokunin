+def note_consumer_args(helper, call, cenv, cbindings, ctx, skip_first=False):
+    """Record which arguments of a followed consumer call need no later sweep.
+
+    A callable handed to a consumer whose body cannot reach it (the parameter
+    is never read) or reaches it only through a call this scan followed with
+    no unparsed row has no execution path the scan does not already own: its
+    sweep would only repeat rows the follow already produced. A consumer that
+    only returns the value hands it back instead; that sweep is redundant only
+    when the returned body was itself followed with no unparsed row, which the
+    caller decides once every call of the cell is known."""
+    if not isinstance(helper, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
+        return
+    if any(isinstance(arg, ast.Starred) for arg in call.args):
+        return
+    names = bound_param_names(helper, call, skip_first)
+    if not names:
+        return
+    bindings = bound_callables(helper, call, cbindings, cenv, skip_first)
+    for argument, param in names.items():
+        escape = parameter_escape(helper, param, ctx)
+        if escape in ("unused", "call"):
+            ctx["safe_args"].add(id(argument))
+        elif escape == "returned":
+            node = bindings.get(param, {}).get("node")
+            if isinstance(node, ast.AST):
+                ctx["returned_args"][id(argument)] = id(node)
+

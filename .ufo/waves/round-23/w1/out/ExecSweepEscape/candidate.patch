+def scope_binds_name(scope, name):
+    """True when `scope` binds `name` itself: a parameter, an assignment or a
+    `global`/`nonlocal` declaration. A nested scope that does so shadows the
+    enclosing name; one that does not reads the enclosing binding."""
+    spec = scope.args
+    for arg in spec.posonlyargs + spec.args + spec.kwonlyargs:
+        if arg.arg == name:
+            return True
+    if spec.vararg is not None and spec.vararg.arg == name:
+        return True
+    if spec.kwarg is not None and spec.kwarg.arg == name:
+        return True
+    for part in ast.walk(scope):
+        if isinstance(part, ast.Name) and part.id == name and \
+                isinstance(part.ctx, (ast.Store, ast.Del)):
+            return True
+        if isinstance(part, (ast.Global, ast.Nonlocal)) and name in part.names:
+            return True
+    return False
+
+
+def parameter_escape(fn, name, ctx):
+    """How the body of `fn` uses its parameter `name`.
+
+    "unused"    the name never appears there: the consumer cannot reach the
+                value it was handed.
+    "call"      the name appears only as the direct target of calls this scan
+                followed with no unparsed row.
+    "returned"  the name appears only as the value of a return.
+    "escape"    anything else: a store, a container, a pass-on, an alias, a
+                yield, a `global`/`nonlocal` name, or a `locals()`/`vars()`
+                read, any of which lets the value reach code this scan does
+                not account for.
+    """
+    uses, parents = [], {}
+
+    def walk_node(node, shadowed):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
+            inner = shadowed or scope_binds_name(node, name)
+            defaults = [expr for expr in node.args.defaults + node.args.kw_defaults
+                        if expr is not None]
+            for expr in list(node.decorator_list) + defaults:
+                walk_node(expr, shadowed)
+            walk_scope(consumer_body(node), inner)
+            return
+        if isinstance(node, ast.Name) and node.id == name and not shadowed:
+            uses.append(node)
+        for child in ast.iter_child_nodes(node):
+            parents[id(child)] = node
+            walk_node(child, shadowed)
+
+    def walk_scope(nodes, shadowed):
+        for node in nodes:
+            walk_node(node, shadowed)
+
+    walk_scope(consumer_body(fn), False)
+    for part in ast.walk(fn):
+        if isinstance(part, ast.Call) and isinstance(part.func, ast.Name) and \
+                part.func.id in ("locals", "vars", "globals"):
+            return "escape"  # any local, the parameter included, may be read
+    if not uses:
+        return "unused"
+    kinds = set()
+    for use in uses:
+        parent = parents.get(id(use))
+        if isinstance(parent, ast.Call) and parent.func is use and \
+                isinstance(use.ctx, ast.Load):
+            kinds.add("call" if id(parent) in ctx["clean_calls"] else "escape")
+        elif isinstance(parent, ast.Return):
+            kinds.add("returned")
+        else:
+            kinds.add("escape")
+    if kinds == {"call"}:
+        return "call"
+    if kinds == {"returned"}:
+        return "returned"
+    return "escape"
+

+def consumer_body(fn):
+    """The statements of a function body, or a lambda's single expression."""
+    return [fn.body] if isinstance(fn, ast.Lambda) else fn.body
+
+
+def bound_param_names(fn, call, skip_first=False):
+    """The parameter each argument of `call` binds to, as bind_literal maps them.
+
+    A starred argument expands to an unknown number of values, so it is left
+    out: the positions after it cannot be mapped."""
+    all_params = [arg.arg for arg in fn.args.posonlyargs + fn.args.args]
+    offset = 1 if skip_first else 0
+    params = all_params[offset:]
+    vararg = fn.args.vararg.arg if fn.args.vararg else None
+    kwarg = fn.args.kwarg.arg if fn.args.kwarg else None
+    keyword_params = set(all_params) | {arg.arg for arg in fn.args.kwonlyargs}
+    result = {}
+    for index, arg in enumerate(call.args):
+        if isinstance(arg, ast.Starred):
+            return {}
+        if index < len(params):
+            result[arg] = params[index]
+        elif vararg is not None:
+            result[arg] = vararg
+    for keyword in call.keywords:
+        if keyword.arg is None:
+            continue
+        if keyword.arg in keyword_params:
+            result[keyword.value] = keyword.arg
+        elif kwarg is not None:
+            result[keyword.value] = kwarg
+    return result
+

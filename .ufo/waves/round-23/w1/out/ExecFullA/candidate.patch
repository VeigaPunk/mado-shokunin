+def parameter_escapes(fn, param):
+    """True when the consumer's parameter value can leave its followed body:
+    stored, returned, aliased or handed to another call. A direct call of the
+    parameter inside the body does not let it escape."""
+    parents = {}
+    stack = [(fn, None)]
+    while stack:
+        node, par = stack.pop()
+        parents[id(node)] = par
+        for child in ast.iter_child_nodes(node):
+            stack.append((child, node))
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Name) and node.id == param:
+            par = parents[id(node)]
+            if isinstance(par, ast.Call) and par.func is node:
+                continue  # a direct call of the parameter is not an escape
+            return True
+    return False
+

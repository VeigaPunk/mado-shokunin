+def consumer_unescaping_args(fn, call, skip_first=False):
+    """Call-argument node ids bound to a parameter that cannot escape the
+    followed consumer body (parameter_escapes). Empty when every callable
+    argument can escape (store/return/alias/pass-on), so the separate sweep
+    of that callback body stays required."""
+    positional = fn.args.posonlyargs + fn.args.args
+    if skip_first:
+        positional = positional[1:]
+    uses = {}
+    for index, arg in enumerate(call.args):
+        if isinstance(arg, ast.Starred):
+            continue
+        pidx = index if not skip_first else index - 1
+        if 0 <= pidx < len(positional):
+            uses[id(arg)] = positional[pidx].arg
+    for keyword in call.keywords:
+        if keyword.arg is not None:
+            uses[id(keyword.value)] = keyword.arg
+    escaping = {p for p in set(uses.values()) if parameter_escapes(fn, p)}
+    return {arg_id for arg_id, p in uses.items() if p not in escaping}
 
 

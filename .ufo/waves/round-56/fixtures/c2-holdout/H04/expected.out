MADO_WATCH: config=$ROOT/tree/hyprland.conf autoreload=on disable_autoreload=unset paths=3 unsupported=0 errors=2
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:2 source=~ reason=bogus
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:3 source=~x reason=nomatch
MADO_WATCH: n=1 role=primary path=$ROOT/tree/hyprland.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=main
MADO_WATCH: n=2 role=primary path=$ROOT/tree/home/a/b.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=$ROOT/tree/hyprland.conf:1
MADO_WATCH: n=3 role=primary path=$ROOT/tree/home/c.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=$ROOT/tree/home/a/b.conf:1
MADO_WATCH: DONE watches=3 unsupported=0 errors=2 live=NONE

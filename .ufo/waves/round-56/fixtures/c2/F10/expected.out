MADO_WATCH: config=$ROOT/tree/hyprland.conf autoreload=on disable_autoreload=unset paths=3 unsupported=0 errors=3
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:1 source=nothing/*.conf reason=nomatch
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:2 source=x reason=bogus
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:3 source=mix/*.conf reason=inaccessible
MADO_WATCH: n=1 role=primary path=$ROOT/tree/hyprland.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=main
MADO_WATCH: n=2 role=primary path=$ROOT/tree/mix/a.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=$ROOT/tree/hyprland.conf:3
MADO_WATCH: n=3 role=primary path=$ROOT/tree/after.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=$ROOT/tree/hyprland.conf:4
MADO_WATCH: DONE watches=3 unsupported=0 errors=3 live=NONE

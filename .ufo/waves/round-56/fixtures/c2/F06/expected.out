MADO_WATCH: config=$ROOT/tree/hyprland.conf autoreload=on disable_autoreload=unset paths=1 unsupported=0 errors=1
MADO_WATCH: ERROR via=$ROOT/tree/hyprland.conf:1 source=inc.conf reason=nomatch
MADO_WATCH: n=1 role=primary path=$ROOT/tree/hyprland.conf type=file mask=IN_CLOSE_WRITE|IN_DONT_FOLLOW via=main
MADO_WATCH: n=2 role=canonical path=$ROOT/tree/real/main.conf type=file mask=IN_CLOSE_WRITE via=main
MADO_WATCH: DONE watches=2 unsupported=0 errors=1 live=NONE

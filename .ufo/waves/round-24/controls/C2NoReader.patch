-def tokenize(line):
-    line = strip_comment(line)
-    lex = shlex.shlex(line, posix=True, punctuation_chars=";&|()<>")
-    lex.whitespace_split = True
-    lex.whitespace = " \t\r"
-    lex.commenters = ""  # comments removed quote-aware by strip_comment()
-    return list(lex)

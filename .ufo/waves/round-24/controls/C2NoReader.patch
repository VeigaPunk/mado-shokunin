-FROZEN_SCHEMA = "mado-tripwire-frozen-v1"
-FROZEN_LABELS = ("clean", "permitted_only", "findings")
-FROZEN_PAIRS = {(0, "clean"), (0, "permitted_only"), (1, "findings")}
-FROZEN_PATH = re.compile(r"inputs/[A-Za-z0-9._-]+\.jsonl")

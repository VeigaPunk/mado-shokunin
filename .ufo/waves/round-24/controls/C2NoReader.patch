-  # --- live rows (PATH/repo probes; SKIP under --no-live, UNKNOWN if absent) -
-  # Round 19 / jj-w1 F9: ask git for the repository, never for a `.git`
-  # directory — a git worktree's `.git` is a FILE, and the old `-d` test read
-  # such a checkout as "no git checkout" and blinded all three identity rows.
-  # The probe lives inside the live arm so a file-plane run spawns no git.
-  if [ -n "$nolive" ]; then
-    row omarchy omarchy.version.cmd SKIP "$nolive"
-    row omarchy omarchy.git.tag SKIP "$nolive"
-    row omarchy omarchy.git.head SKIP "$nolive"
-    row omarchy omarchy.skill.vs_head SKIP "$nolive"
-    row omarchy omarchy.cmd.groups SKIP "$nolive"
-    row omarchy omarchy.cmd.surface SKIP "$nolive"
-    row omarchy omarchy.theme SKIP "$nolive"
-  else
-    local omtree=0
-    # Round 19 / jj-w1 F9 + the ReviewJjFinal correction: a checkout is a
-    # `.git` entry in THIS tree (a directory, or a FILE for a git worktree).
-    # `rev-parse --git-dir` alone walks UP, so a .git-less tree under an
-    # ancestor repository (e.g. ~/.local/share/omarchy under a dotfiles repo)
-    # would resolve to that repo and the pin rows would judge the wrong
-    # checkout. Require the entry first; without it the rows stay the old
-    # "no git checkout at …" UNKNOWN.
-    if [ -e "$tree/.git" ] && have git \
-       && tmo git -C "$tree" rev-parse --git-dir >/dev/null 2>&1; then
-      omtree=1
-    fi
-    if ! have omarchy; then
-      row omarchy omarchy.version.cmd UNKNOWN "omarchy not on PATH — version pin unverified (blocks CLEAN)"
-    else
-      local ov orc

-                       "--downloadonly": "w", "--clean": "c"}[a])
-        elif a in ("--print", "--search", "--info", "--list", "--groups"):
-            flags.add({"--print": "p", "--search": "s", "--info": "i",
-                       "--list": "l", "--groups": "g"}[a])

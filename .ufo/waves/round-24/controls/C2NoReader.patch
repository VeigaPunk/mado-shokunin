diff --git a/.ufo/waves/round-19/landed-check.sh b/.ufo/waves/round-19/landed-check.sh
index 2fbe2b5..742e13d 100755
--- a/.ufo/waves/round-19/landed-check.sh
+++ b/.ufo/waves/round-19/landed-check.sh
@@ -1,189 +1,2 @@
 #!/usr/bin/env bash
-# =============================================================================
-# landed-check.sh — read-only landedness classifier for one lane checkout
-#
-# Origin: round-19 lane Mado / jj audit F16 — no lane tool could tell a pushed
-# commit from an unpushed one, and `git status` clean does not mean landed
-# (audit F17). This tool answers one question per hash: is it on origin/master?
-#
-# Usage:
-#   landed-check.sh LANE_DIR HASH...
-#
-#   LANE_DIR   a git checkout (a jj-colocated checkout works; only git reads)
-#   HASH...    full or abbreviated hex object names
-#
-# Output (stdout, one line per HASH, input order):
-#   LANDED <hash>      object present locally and ancestor of the remote tip
-#   LOCAL_ONLY <hash> (reason)
-#                      present locally, not landed. Reason is one of:
-#                        ancestor of refs/heads/master but not of origin/master
-#                        remote tip object absent locally (ancestry untestable)
-#                        ancestor of neither refs/heads/master nor origin/master
-#                        refs/heads/master absent locally
-#                        object present but not a commit
-#                        ancestry test against origin/master errored rc=N
-#   MISSING <hash>     object absent locally
-#
-# The remote tip is resolved live, never from a stale remote-tracking ref:
-#   git -C LANE ls-remote origin refs/heads/master
-# That is a network READ. This tool never fetches, never writes git state
-# (no index read, no ref update, no worktree touch) and never invokes jj.
-#
-# Exit map: 0 all HASHes LANDED · 1 any LOCAL_ONLY or MISSING
-#           2 usage error, or could-not-evaluate (not a repo, no origin, no
-#             refs/heads/master there, ls-remote failed, ancestry test error)
-# =============================================================================
-
-set -u
-
-PROG=${0##*/}
-
-usage() {
-  printf 'usage: %s LANE_DIR HASH...\n' "$PROG" >&2
-  exit 2
-}
-
-die2() {
-  printf '%s: %s\n' "$PROG" "$*" >&2
-  exit 2
-}
-
-[ "$#" -ge 2 ] || usage
-LANE=$1
-shift
-[ -n "$LANE" ] || usage
-[ -d "$LANE" ] || die2 "not a directory: $LANE"
-
-for h in "$@"; do
-  case $h in
-    *[!0-9a-fA-F]*) die2 "not a hex object name: $h" ;;
-  esac
-  if [ "${#h}" -lt 4 ] || [ "${#h}" -gt 64 ]; then
-    die2 "object name length out of range (4..64 hex): $h"
-  fi
-done
-
-command -v git >/dev/null 2>&1 || die2 "git not found in PATH"
-
-# Read-only posture: no interactive credential prompts, no implicit lazy fetch
-# in partial clones, no optional index locks. `ls-remote` is time-bounded so a
-# dead remote cannot hang a wave.
-GIT_TERMINAL_PROMPT=0
-GIT_NO_LAZY_FETCH=1
-GIT_OPTIONAL_LOCKS=0
-export GIT_TERMINAL_PROMPT GIT_NO_LAZY_FETCH GIT_OPTIONAL_LOCKS
-
-tmo() {
-  if command -v timeout >/dev/null 2>&1; then
-    timeout 60 "$@"
-  else
-    "$@"
-  fi
-}
-
-git -C "$LANE" rev-parse --git-dir >/dev/null 2>&1 \
-  || die2 "not a git checkout: $LANE"
-
-lsr=$(tmo git -C "$LANE" ls-remote origin refs/heads/master 2>/dev/null) \
-  || die2 "git ls-remote origin refs/heads/master failed in $LANE"
-
-remote_tip=$(printf '%s\n' "$lsr" | awk '$2 == "refs/heads/master" { print $1; exit }')
-[ -n "$remote_tip" ] || die2 "origin has no refs/heads/master: $LANE"
-case $remote_tip in
-  *[!0-9a-f]*) die2 "unexpected ls-remote object id: $remote_tip" ;;
-esac
-if [ "${#remote_tip}" -ne 40 ] && [ "${#remote_tip}" -ne 64 ]; then
-  die2 "unexpected ls-remote object id length: $remote_tip"
-fi
-
-# Resolve the remote tip to a local commit object. A lane that has not fetched
-# since the remote moved cannot prove ancestry; that is reported per hash, not
-# papered over with a fetch.
-remote_known=0
-resolved_remote=
-if resolved_remote=$(git -C "$LANE" rev-parse --verify --quiet "${remote_tip}^{commit}" 2>/dev/null) \
-   && [ -n "$resolved_remote" ]; then
-  remote_known=1
-fi
-
-local_master=
-local_master=$(git -C "$LANE" rev-parse --verify --quiet 'refs/heads/master^{commit}' 2>/dev/null) \
-  || local_master=
-
-shallow=$(git -C "$LANE" rev-parse --path-format=absolute --git-path shallow 2>/dev/null) || shallow=
-if [ -n "$shallow" ] && [ -f "$shallow" ]; then
-  printf '%s: warning: shallow clone — ancestry is bounded by the shallow boundary (false LOCAL_ONLY possible)\n' "$PROG" >&2
-fi
-
-if [ "$remote_known" = 1 ]; then
-  printf '%s: origin/master = %s (object present locally)\n' "$PROG" "$remote_tip" >&2
-else
-  printf '%s: origin/master = %s (object ABSENT locally; no fetch performed)\n' "$PROG" "$remote_tip" >&2
-fi
-
-landed_all=1
-unevaluable=0
-
-for h in "$@"; do
-  full=
-  full=$(git -C "$LANE" rev-parse --verify --quiet "${h}^{commit}" 2>/dev/null) || full=
-
-  if [ -z "$full" ]; then
-    landed_all=0
-    if git -C "$LANE" cat-file -e "$h" 2>/dev/null; then
-      printf 'LOCAL_ONLY %s (object present but not a commit)\n' "$h"
-    else
-      printf 'MISSING %s\n' "$h"
-    fi
-    continue
-  fi
-
-  if [ "$remote_known" = 1 ]; then
-    git -C "$LANE" merge-base --is-ancestor "$full" "$resolved_remote" 2>/dev/null
-    mbrc=$?
-    case $mbrc in
-      0)
-        printf 'LANDED %s\n' "$full"
-        continue
-        ;;
-      1)
-        ;;
-      *)
-        printf 'LOCAL_ONLY %s (ancestry test against origin/master %s errored rc=%s)\n' \
-          "$full" "$remote_tip" "$mbrc"
-        landed_all=0
-        unevaluable=1
-        continue
-        ;;
-    esac
-
-    landed_all=0
-    if [ -n "$local_master" ] \
-       && git -C "$LANE" merge-base --is-ancestor "$full" "$local_master" 2>/dev/null; then
-      printf 'LOCAL_ONLY %s (ancestor of refs/heads/master, not of origin/master %s)\n' \
-        "$full" "$remote_tip"
-    elif [ -n "$local_master" ]; then
-      printf 'LOCAL_ONLY %s (ancestor of neither refs/heads/master nor origin/master %s)\n' \
-        "$full" "$remote_tip"
-    else
-      printf 'LOCAL_ONLY %s (not an ancestor of origin/master %s; refs/heads/master absent locally)\n' \
-        "$full" "$remote_tip"
-    fi
-  else
-    landed_all=0
-    if [ -n "$local_master" ] \
-       && git -C "$LANE" merge-base --is-ancestor "$full" "$local_master" 2>/dev/null; then
-      printf 'LOCAL_ONLY %s (ancestor of refs/heads/master; remote tip %s is absent locally, ancestry untestable without a fetch)\n' \
-        "$full" "$remote_tip"
-    else
-      printf 'LOCAL_ONLY %s (remote tip %s is absent locally, ancestry untestable; not an ancestor of refs/heads/master either)\n' \
-        "$full" "$remote_tip"
-    fi
-  fi
-done
-
-if [ "$unevaluable" = 1 ]; then
-  exit 2
-fi
-[ "$landed_all" = 1 ] && exit 0
-exit 1
+exit 0
diff --git a/.ufo/waves/round-20/a2/a2-guards.py b/.ufo/waves/round-20/a2/a2-guards.py
index f49d461..147994f 100755
--- a/.ufo/waves/round-20/a2/a2-guards.py
+++ b/.ufo/waves/round-20/a2/a2-guards.py
@@ -1,188 +1,2 @@
 #!/usr/bin/env python3
-"""Round-20 attempt-2 guard counter over the wave-2 adversarial fixtures.
-
-Usage: a2-guards.py REV --fixtures-rev PIN
-
-Reads `REV:tools/mado-tripwire.py` and the fixture bytes at PIN (`git show`
-only), scans every fixture one file per process (`python3 -I --scan`, cwd =
-temp) and prints one JSON object. Fixtures are data; nothing in them runs.
-
-Metrics (populations frozen at PIN, each listed by file):
-  recall_lost   files in the recall sets where 9c54c56 or 1f7f995 reports a
-                row and REV reports none (declared exclusions listed apart)
-  crash_flip    AdvCrash files where REV exits 2 and 1f7f995 does not
-  pure_rows     the 24 AdvPureShapes fixtures AdvPureShapes named as pure
-                data that still produce a row at REV
-  vcs_fn/vcs_fp AdvVcsForms manifest truth vs REV (`write` missed / a
-                measured non-write flagged); boundary cases are not scored
-  a2_mismatch   a2/fixtures manifest truth (finding|write|clean) vs REV
-  dup_rows      tool calls carrying both an observed and a lead row for the
-                same (class, rule)
-  slowest       the slowest REV scan (seconds) and its file
-"""
-import concurrent.futures
-import hashlib
-import json
-import os
-import subprocess
-import sys
-import tempfile
-import time
-
-LANE = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
-    os.path.dirname(os.path.abspath(__file__))))))
-W2 = ".ufo/waves/round-20/w2/"
-A2 = ".ufo/waves/round-20/a2/fixtures/"
-BASES = {"pre_harm": "9c54c56a6a7528675027b7f628f97a1b8d1b8e8d",
-         "harmed": "1f7f995caa25627db804e996cccd87fe38a3a1b6"}
-RECALL_DIRS = (W2 + "AdvRecallShapes/fixtures/", W2 + "AdvDepth/silent-only/")
-RECALL_PREFIX = ((W2 + "AdvLeadMarks/", "miss-"),)
-RECALL_EXCLUDED = {  # declared by the seat that wrote them, before any repair
-    W2 + "AdvRecallShapes/fixtures/gap04-lambda-argv-lead.jsonl": "old false positive (AdvRecallShapes)",
-    W2 + "AdvRecallShapes/fixtures/ar49-signal-handler-lambda.jsonl": "signal-contingent (AdvRecallShapes)",
-}
-CRASH_DIRS = (W2 + "AdvCrash/fixtures/", W2 + "AdvCrash/fixtures2/")
-PURE_IDS = ("ap01", "ap02b", "ap03", "ap04", "ap05", "ap06", "ap07", "ap08",
-            "ap09", "ap10", "ap11", "ap14", "ap15", "ap16", "ap17", "ap18",
-            "ap19", "ap20", "ap21", "ap23", "ap24", "ap25", "ap26", "ap27")
-VCS_DIR = W2 + "AdvVcsForms/fixtures/"
-TIMEOUT = 120
-
-
-def git(*args, text=False):
-    proc = subprocess.run(["git", "-C", LANE] + list(args), capture_output=True, text=text)
-    if proc.returncode != 0:
-        sys.exit("a2-guards: git %s failed: %s" % (" ".join(args), proc.stderr))
-    return proc.stdout
-
-
-def listing(pin, prefix):
-    out = git("ls-tree", "-r", "--name-only", pin, "--", prefix, text=True)
-    return sorted(p for p in out.splitlines() if p.endswith(".jsonl"))
-
-
-def scan(tool, path, tmp):
-    start = time.monotonic()
-    try:
-        proc = subprocess.run([sys.executable, "-I", tool, "--scan", path], cwd=tmp,
-                              capture_output=True, text=True, timeout=TIMEOUT)
-    except subprocess.TimeoutExpired:
-        return {"exit": None, "rows": [], "seconds": TIMEOUT, "timeout": True}
-    seconds = round(time.monotonic() - start, 3)
-    rows = []
-    lines = proc.stdout.splitlines()
-    if len(lines) >= 2:
-        try:
-            payload = json.loads(lines[1])
-            rows = [(f.get("line"), f.get("tool_call_id"), f["class"], f["rule"],
-                     f.get("evidence", "observed")) for f in payload.get("findings", [])]
-        except ValueError:
-            pass
-    return {"exit": proc.returncode, "rows": rows, "seconds": seconds, "timeout": False}
-
-
-def main(argv):
-    if len(argv) != 3 or argv[1] != "--fixtures-rev":
-        sys.exit("usage: a2-guards.py REV --fixtures-rev PIN")
-    rev = git("rev-parse", "--verify", argv[0] + "^{commit}", text=True).strip()
-    pin = git("rev-parse", "--verify", argv[2] + "^{commit}", text=True).strip()
-    tmp = tempfile.mkdtemp(prefix="a2-guards-")
-    tools = {}
-    for label, r in [("rev", rev)] + list(BASES.items()):
-        data = git("show", "%s:tools/mado-tripwire.py" % r)
-        path = os.path.join(tmp, "tw-%s.py" % label)
-        open(path, "wb").write(data)
-        tools[label] = (path, hashlib.sha256(data).hexdigest())
-
-    recall = [p for d in RECALL_DIRS for p in listing(pin, d)]
-    recall += [p for d, pre in RECALL_PREFIX for p in listing(pin, d)
-               if os.path.basename(p).startswith(pre)]
-    crash = [p for d in CRASH_DIRS for p in listing(pin, d)]
-    pure = [p for p in listing(pin, W2 + "AdvPureShapes/fixtures/")
-            if os.path.basename(p).split("-")[1] in PURE_IDS]
-    vcs = listing(pin, VCS_DIR)
-    a2 = listing(pin, A2)
-    files = sorted(set(recall + crash + pure + vcs + a2))
-    local = {}
-    for p in files:
-        dest = os.path.join(tmp, "fx", p)
-        os.makedirs(os.path.dirname(dest), exist_ok=True)
-        open(dest, "wb").write(git("show", "%s:%s" % (pin, p)))
-        local[p] = dest
-
-    jobs = [("rev", p) for p in files]
-    jobs += [(b, p) for b in BASES for p in recall]
-    jobs += [("harmed", p) for p in crash]
-    results = {}
-    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
-        futs = {pool.submit(scan, tools[label][0], local[p], tmp): (label, p)
-                for label, p in jobs}
-        for fut in concurrent.futures.as_completed(futs):
-            results[futs[fut]] = fut.result()
-
-    def rows(label, p):
-        return results[(label, p)]["rows"]
-
-    lost, excluded = [], []
-    for p in recall:
-        if any(rows(b, p) for b in BASES) and not rows("rev", p):
-            (excluded if p in RECALL_EXCLUDED else lost).append(p)
-    crash_flip = [p for p in crash if results[("rev", p)]["exit"] == 2
-                  and results[("harmed", p)]["exit"] != 2]
-    rev_exit2 = [p for p in crash if results[("rev", p)]["exit"] == 2]
-    pure_rows = [p for p in pure if rows("rev", p)]
-
-    def truths(prefix):
-        raw = git("show", "%s:%smanifest.json" % (pin, prefix), text=True)
-        return {c["case"]: c["truth"] for c in json.loads(raw)}
-
-    vcs_truth = truths(VCS_DIR)
-    vcs_fn, vcs_fp = [], []
-    for p in vcs:
-        truth = vcs_truth.get(os.path.basename(p)[:-6])
-        write = any(r[2] == "vcs_write" for r in rows("rev", p))
-        if truth == "write" and not write:
-            vcs_fn.append(p)
-        elif truth == "nowrite" and write:
-            vcs_fp.append(p)
-    a2_truth = truths(A2)
-    a2_mismatch = []
-    for p in a2:
-        truth = a2_truth.get(os.path.basename(p)[:-6])
-        got = rows("rev", p)
-        ok = (bool(got) if truth == "finding" else
-              any(r[2] == "vcs_write" for r in got) if truth == "write" else
-              not got if truth == "clean" else False)
-        if not ok or results[("rev", p)]["exit"] not in (0, 1):
-            a2_mismatch.append(p)
-    dup = []
-    for p in files:
-        seen = {}
-        for line, call, cls, rule, ev in rows("rev", p):
-            seen.setdefault((line, call, cls, rule), set()).add(ev)
-        dup += ["%s:%s" % (p, k[0]) for k, evs in seen.items() if len(evs) > 1]
-    slow_p = max(files, key=lambda p: results[("rev", p)]["seconds"])
-    out = {
-        "schema": "mado-r20-a2-guards-v1", "rev": rev, "fixtures_rev": pin,
-        "tool_sha256": {k: v[1] for k, v in tools.items()},
-        "populations": {"recall": len(recall), "crash": len(crash), "pure": len(pure),
-                        "vcs": len(vcs), "a2": len(a2)},
-        "recall_lost": len(lost), "recall_lost_files": lost,
-        "recall_excluded": {p: RECALL_EXCLUDED[p] for p in excluded},
-        "crash_flip": len(crash_flip), "crash_flip_files": crash_flip,
-        "rev_exit2": len(rev_exit2),
-        "pure_rows": len(pure_rows), "pure_rows_files": pure_rows,
-        "vcs_fn": len(vcs_fn), "vcs_fn_files": vcs_fn,
-        "vcs_fp": len(vcs_fp), "vcs_fp_files": vcs_fp,
-        "a2_mismatch": len(a2_mismatch), "a2_mismatch_files": a2_mismatch,
-        "dup_rows": len(dup), "dup_row_sites": dup,
-        "timeouts": sorted(p for (label, p), r in results.items() if r["timeout"] and label == "rev"),
-        "a2_seconds": {os.path.basename(p): results[("rev", p)]["seconds"] for p in a2},
-        "slowest": {"file": slow_p, "seconds": results[("rev", slow_p)]["seconds"]},
-    }
-    print(json.dumps(out, indent=1, sort_keys=True))
-    return 0
-
-
-if __name__ == "__main__":
-    sys.exit(main(sys.argv[1:]))
+raise SystemExit(0)
diff --git a/.ufo/waves/round-20/isolation-check.sh b/.ufo/waves/round-20/isolation-check.sh
index 679f258..742e13d 100755
--- a/.ufo/waves/round-20/isolation-check.sh
+++ b/.ufo/waves/round-20/isolation-check.sh
@@ -1,252 +1,2 @@
-#!/usr/bin/bash
-# This check covers setup-failure behavior only. It is not a containment test.
-set -u
-
-if (($# != 1)); then
-    printf 'usage: %s HARNESS\n' "$0" >&2
-    printf 'COULD_NOT_EVALUATE harness argument missing\n'
-    exit 2
-fi
-harness=$(/usr/bin/realpath -e -- "$1" 2>/dev/null) || {
-    printf 'COULD_NOT_EVALUATE %s (harness path does not resolve)\n' "${1##*/}"
-    exit 2
-}
-harness_name=${harness##*/}
-if [[ ! -x $harness ]]; then
-    printf 'COULD_NOT_EVALUATE %s (not executable)\n' "$harness_name"
-    exit 2
-fi
-
-printf 'SCOPE %s: fail-closed setup only; not containment; not a sandbox; never run a host probe under the host pause.\n' "$harness_name"
-original_path=$PATH
-# Do not let test controls inherited by this checker leak into its subject.
-unset CHECK_MODE CHECK_MARKER CHECK_REAL_PATH
-unset -f mount unshare cmp 2>/dev/null || :
-umask 077
-tmp=$(/usr/bin/mktemp -d /tmp/mado-isolation-v3-check.XXXXXX) || {
-    printf 'COULD_NOT_EVALUATE %s (cannot create /tmp workspace)\n' "$harness_name"
-    exit 2
-}
-observer=$(/usr/bin/mktemp -d /tmp/mado-isolation-v3-observer.XXXXXX) || {
-    /usr/bin/rm -rf -- "$tmp"
-    printf 'COULD_NOT_EVALUATE %s (cannot create witness workspace)\n' "$harness_name"
-    exit 2
-}
-/usr/bin/chmod 700 -- "$tmp" "$observer" || exit 2
-trap '/usr/bin/rm -rf -- "$tmp" "$observer"' EXIT
-
-cat > "$tmp/payload.sh" <<'EOF'
-#!/usr/bin/bash
-set -u
-[[ $# == 1 ]] || exit 91
-printf 'payload-ran\n' > "$1"
-printf 'payload-ran\n' >&9
-EOF
-/usr/bin/chmod 700 -- "$tmp/payload.sh" || exit 2
-
-open_witness() {
-    local witness_path=$observer/witness-$1
-    : > "$witness_path" || exit 2
-    exec 9<> "$witness_path" || exit 2
-    # Unlink the pathname before the harness starts; the payload inherits only fd 9.
-    /usr/bin/rm -f -- "$witness_path" || exit 2
-}
-
-close_witness() {
-    exec 9>&- || :
-}
-
-overall_failure=0
-overall_unknown=0
-
-run_case() {
-    local name=$1
-    local mode=$2
-    shift 2
-    local case_dir
-    case_dir=$(/usr/bin/mktemp -d "$tmp/case.XXXXXX") || exit 2
-    local case_bin=$case_dir/bin
-    local stub_path=$case_dir/stub
-    local canary=$case_dir/canary
-    local marker=$case_dir/injected
-    local cmp_marker=$case_dir/cmp-invoked
-    local log=$case_dir/output.log
-    local run_path=$original_path
-    local status=0
-    local injection_required=0
-    local target_name target marker_q mode_q real_path_q cmp_marker_q
-    local canary_state witness_state marker_state cmp_state
-    local -a targets=()
-    local -a args=()
-
-    /usr/bin/mkdir -p -- "$case_bin" || exit 2
-    : > "$marker" || exit 2
-    : > "$cmp_marker" || exit 2
-    if [[ $mode != missing-stub ]]; then
-        printf 'stub-bytes-%s\n' "$name" > "$stub_path" || exit 2
-    fi
-    for target_name in "$@"; do
-        target=$case_dir/$target_name
-        targets+=("$target")
-        if [[ ! ( $mode == missing-target && $target_name == absent ) ]]; then
-            printf 'original-bytes-%s-%s\n' "$name" "$target_name" > "$target" || exit 2
-        fi
-    done
-
-    case $mode in
-        mount-nonzero|mount-noop|partial-arm)
-            injection_required=1
-            run_path=$case_bin:$original_path
-            printf -v marker_q '%q' "$marker"
-            printf -v mode_q '%q' "$mode"
-            printf -v real_path_q '%q' "$original_path"
-            cat > "$case_bin/mount" <<EOF
-#!/usr/bin/bash
-set -u
-injected_marker=$marker_q
-injected_mode=$mode_q
-real_path=$real_path_q
-printf '%s\\n' "\${3-<no-target>}" >> "\$injected_marker" || exit 97
-case "\$injected_mode" in
-    mount-nonzero)
-        printf 'forced mount failure (exit 32)\\n' >&2
-        exit 32
-        ;;
-    mount-noop)
-        printf 'forced successful no-op mount\\n' >&2
-        exit 0
-        ;;

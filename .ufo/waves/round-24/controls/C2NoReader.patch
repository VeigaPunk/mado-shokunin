-row() { # plane id status detail
-  local plane="$1" id="$2" st="$3" detail="$4"
-  ROWS+=("$plane|$id|$st|$detail")
-  case "$st" in
-    PASS) PASS=$((PASS + 1)) ;;
-    FAIL) FAIL=$((FAIL + 1)) ;;
-    UNKNOWN) UNKNOWN=$((UNKNOWN + 1)) ;;
-    SKIP) SKIP=$((SKIP + 1)) ;;
-    NOTE) NOTE=$((NOTE + 1)) ;;

-    show)
-      if [ "${STUB_GIT_SHOW_RC:-0}" != 0 ]; then exit "$STUB_GIT_SHOW_RC"; fi
-      cat "${STUB_GIT_BLOB:-/dev/null}"; exit 0 ;;
-  esac
-  shift
-done
-exit 64

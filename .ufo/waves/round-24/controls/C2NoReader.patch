-            continue
-        if index < first_default:
-            return None
-        bound[name] = literal_value(fn.args.defaults[index - first_default], {})
-    for name, default in zip(kwonly_params, fn.args.kw_defaults):
-        if name not in bound:
-            if default is None:
-                return None
-            bound[name] = literal_value(default, {})
-    return bound

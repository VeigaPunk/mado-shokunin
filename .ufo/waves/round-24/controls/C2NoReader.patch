-def strip_comment(line):
-    """Drop a bash comment: '#' at word start, outside quotes, not escaped."""
-    quote = None
-    i = 0
-    while i < len(line):
-        ch = line[i]
-        if quote:
-            if ch == "\\" and quote == '"':
-                i += 2
-                continue
-            if ch == quote:
-                quote = None
-        elif ch == "\\":
-            i += 2
-            continue
-        elif ch in ("'", '"'):
-            quote = ch
-        elif ch == "#" and (i == 0 or line[i - 1] in " \t\n;&|()<>"):
-            return line[:i]
-        i += 1
-    return line

-        if [ "$ov" = "$OMARCHY_VERSION_PIN" ]; then
-          row omarchy omarchy.version.cmd PASS "HELD: 'omarchy version' → $ov (P1 pin)"
-        else
-          row omarchy omarchy.version.cmd FAIL "MOVED: 'omarchy version' → '${ov:-<empty>}' != pin $OMARCHY_VERSION_PIN"
-        fi
-      fi
-    fi
-
-    if ! have git; then
-      row omarchy omarchy.git.tag UNKNOWN "git not on PATH — checkout identity unverified"
-      row omarchy omarchy.git.head UNKNOWN "git not on PATH — checkout identity unverified"
-    elif [ "$omtree" = 0 ]; then
-      row omarchy omarchy.git.tag UNKNOWN "no git checkout at $tree"
-      row omarchy omarchy.git.head UNKNOWN "no git checkout at $tree"
-    else
-      # Round 19 / jj-w1 F6 + the honesty correction: read the tip commit the
-      # checkout's branch names, never HEAD — but only under jj colocation.
-      # A jj-colocated tree ($tree/.jj) detaches HEAD onto an empty working-copy
-      # commit, where `describe` exits 128 (tag invisible) and `rev-parse HEAD`
-      # names an unexported commit, so the old rows read UNKNOWN and a false
-      # MOVED on a pinned checkout. A *plain-git* detached HEAD keeps the HEAD
-      # reading: rescuing it with a branch tip would hide a real MOVED.
-      # No fetch, no write: symbolic-ref, for-each-ref, rev-parse --verify.
-      local jcol=0
-      [ -d "$tree/.jj" ] && jcol=1
-      local tip="" tipref="" tipwhy="" gt gh grc nbr=0 brrefs="" jjok=0
-      local candref="" cand="" htree="" ctree=""
-      tipref=$(tmo git -C "$tree" symbolic-ref -q HEAD 2>/dev/null); grc=$?
-      tipref=$(printf '%s' "$tipref" | head -1)
-      if [ "$grc" != 0 ] || [ -z "$tipref" ]; then
-        tipref=""
-        if [ "$jcol" = 1 ]; then
-          # Detached HEAD in a jj-colocated checkout. The rescue is allowed
-          # only for an EMPTY working-copy commit on top of the single branch
-          # tip, proven by HEAD^{tree} == <tip>^{tree}. `jj new v3.8.3` with
-          # the bookmark still at the pin has a different tree and must keep
-          # the HEAD reading, or a real MOVED would be hidden (CriticAdmission).

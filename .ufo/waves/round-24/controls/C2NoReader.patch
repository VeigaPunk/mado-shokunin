-def mutated_literal(value, env):
-    changed = env.get(MUTATED_LITERALS, ())
-    if not changed:
-        return False
-    pending = [value]
-    while pending:
-        item = pending.pop()
-        if id(item) in changed:
-            return True
-        if isinstance(item, (list, tuple)):
-            pending.extend(item)
-        elif isinstance(item, dict):
-            pending.extend(item.values())
-    return False

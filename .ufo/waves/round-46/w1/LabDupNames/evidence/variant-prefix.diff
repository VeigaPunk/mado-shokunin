+        ("nested-not-input", ["general {\n  kb_layout = de\n}\n"], dump([kb("k")]), "OK", 0, ["verdict=AGREE"]),
+        ("case-sensitive-name", ["device {\nname = K\nkb_layout = de\n}\n"], dump([kb("k")]), "STALE_BLOCK", 4,
+         ["block=no"]),
